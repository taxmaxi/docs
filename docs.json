              "cli/flags"
            ]
          },
          {
            "group": "JavaScript SDK",
            "pages": [
              "sdk/overview",
              "sdk/installation",
              "sdk/sources",
              "sdk/error-handling"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/sources",
              "concepts/sync-jobs",
              "concepts/tax-calculation",
              "concepts/jurisdictions"
            ]
          }
        ]
      },
      {
