  "keyFeatures": [
    "REST API for crypto tax calculation (German jurisdiction)",
    "Coinbase OAuth integration with one-command workflow",
    "Transaction sync, normalization, and FIFO-based tax computation",
    "CLI tool installable via npm (`npm install -g tax`)",
    "JavaScript/TypeScript SDK with Promise and Effect interfaces",
    "Legal reference API for grounding AI agents in statute-backed citations",
    "Machine-readable JSON output for automation and AI agent integration",
    "Pollable async sync jobs with status tracking"
  ],
